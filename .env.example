# ════════════════════════════════════════════════════════
#  求职助手 · 部署配置
#  复制成 .env 再改，别把真的 .env 提交进仓库
# ════════════════════════════════════════════════════════

# ── 必填：AI 服务密钥 ──────────────────────────────────
# DeepSeek（文本：改简历、出题、面试官对话）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 DashScope（视觉识别截图 + 语音识别 + 语音合成）
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-max
ASR_MODEL=qwen3-asr-flash
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry

# ── 必填：会话签名密钥 ─────────────────────────────────
# 不填的话程序会自己生成一个存在 data/.secret，
# 但容器重建后文件丢了 → 所有人都被踢下线。生成一个填这里：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── 初始管理员 ────────────────────────────────────────
# 首次启动时如果没有账号，会用这两个值建一个管理员。
# 登录后请立刻在「我的 → 设置」里改密码，然后把 ADMIN_PASSWORD 从 .env 里删掉。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── HTTPS / 域名 ──────────────────────────────────────
# 备案下来之前：SITE_ADDRESS=:443，Caddy 用自签证书，用 https://IP 访问
# 备案下来之后：SITE_ADDRESS=你的域名，Caddy 自动申请 Let's Encrypt 真证书
# ⚠️ 域名不能带下划线（公共 CA 拒绝签发），用 resume.xxx.com 而不是 resume_assistant.xxx.com
SITE_ADDRESS=:443
ACME_EMAIL=
# 备案前用 Caddyfile.ip（自签证书，IP 访问）
# 备案后换成 Caddyfile.domain（域名 + Let's Encrypt 真证书）
CADDYFILE=Caddyfile.ip

# 走 HTTPS 之后把这里设成 1，浏览器只会在加密连接里带上登录 cookie
COOKIE_SECURE=1
